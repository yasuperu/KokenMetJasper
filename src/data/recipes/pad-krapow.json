{
  "id": "pad-krapow",
  "title": "Thaise Pad Krapow",
  "category": "Hoofdgerecht",
  "tags": [
    "Thais",
    "Pittig"
  ],
  "servings": 4,
  "prepTime": 10,
  "cookTime": 10,
  "image": "",
  "description": "Een pittige Thaise favoriet met gehakt en Thaise basilicum.",
  "ingredients": [
    {
      "id": "zonnebloemolie",
      "name": "zonnebloemolie",
      "amount": 3.5,
      "unit": "el"
    },
    {
      "id": "rodePeper",
      "name": "rode peper",
      "amount": 3,
      "note": "fijngehakt"
    },
    {
      "id": "sjalot",
      "name": "sjalot",
      "amount": 3,
      "note": "in dunne ringen"
    },
    {
      "id": "knoflook",
      "name": "knoflook",
      "amount": 5,
      "unit": "teentje",
      "note": "in dunne plakjes"
    },
    {
      "id": "kipOfVarkensgehakt",
      "name": "kip- of varkensgehakt",
      "amount": 500,
      "unit": "gr"
    },
    {
      "id": "suiker",
      "name": "suiker",
      "amount": 2,
      "unit": "el"
    },
    {
      "id": "sojasaus",
      "name": "sojasaus",
      "amount": 2,
      "unit": "el"
    },
    {
      "id": "vissaus",
      "name": "vissaus",
      "amount": 1,
      "unit": "el"
    },
    {
      "id": "bouillon",
      "name": "water of kippenbouillon",
      "amount": 90,
      "unit": "ml"
    },
    {
      "id": "thaiseBasilicum",
      "name": "Thaise basilicum",
      "amount": 1,
      "unit": "bos"
    },
    {
      "id": "gekookteRijst",
      "name": "gekookte rijst",
      "note": "om mee te serveren"
    }
  ],
  "instructions": [
    "Verhit {zonnebloemolie} in een wok op hoog vuur. Voeg {rodePeper}, {sjalot} en {knoflook} toe. Bak 1 tot 2 minuten tot alles zacht is en goudbruin, let op dat het niet verbrandt.",
    "Voeg {kipOfVarkensgehakt} toe en bak het in enkele minuten rul.",
    "Voeg {suiker}, {sojasaus} en {vissaus} toe. Bak nog een minuut door.",
    "Blus de pan af met {bouillon}. Wacht tot het vocht deels is verdampt.",
    "Voeg {thaiseBasilicum} toe en roer door tot het geslonken is.",
    "Serveer met {gekookteRijst:naam}."
  ]
}
