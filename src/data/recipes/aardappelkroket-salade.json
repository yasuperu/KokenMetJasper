  "instructions": [
    "Verwarm de oven voor op 220 graden.",
    "Verdeel {aardappelkroketjes} over een bakplaat met bakpapier.",
    "Snijd {halloumi} in kleine blokjes en meng met {honing} en {crispyChiliOlie}. Verdeel de {halloumi:naam} ook over de bakplaat.",
    "Bak 15-20 minuten in de oven en schep halverwege voorzichtig om. Tip: bak de {aardappelkroketjes:naam} los in de airfryer, dan worden ze nog knapperiger.",
    "Snijd ondertussen {komkommer}, {bosui}, {avocado} en {augurk} en doe alles samen met {ingelegdeRodeUi} in een schaal.",
    "Blend voor de dressing {verseDille}, {verseKoriander}, {knoflook}, {griekseYoghurt}, {mayonaise}, {augurkenvocht}, {zout} en {peper:naam} fijn met een staafmixer.",
    "Serveer de salade met de {aardappelkroketjes:naam}, de {halloumi:naam} en de dressing."
  ]
}
